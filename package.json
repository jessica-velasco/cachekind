{
  "name": "cachekind",
  "version": "0.0.0",
  "description": "A resilient Redis cache handler for self-hosted Next.js",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:probe": "npm run build --workspace @cachekind/contract-probe",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "start:probe": "npm run start --workspace @cachekind/contract-probe",
    "test": "npm run build && node --test test/*.test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "verify:probe": "npm run build:probe && node scripts/verify-contract.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "peerDependencies": {
    "next": ">=16.2.0 <17"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "nextjs",
    "redis",
    "cache-handler",
    "self-hosted",
    "isr",
    "incremental-cache",
    "kubernetes",
    "elasticache",
    "valkey"
  ],
  "overrides": {
    "next": {
      "postcss": "8.5.10"
    }
  }
}
